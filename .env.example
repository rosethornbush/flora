CODEX_MODEL=gpt-6-luna
CHATGPT_APPS=search_service,shop,target,github
DISCORD_TOKEN=
DISCORD_OWNER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# VPS OAuth callbacks; configure this hostname in your Cloudflare Tunnel.
# FLORA_PUBLIC_URL=https://flora.example.com
# CLOUDFLARE_TUNNEL_TOKEN=
# FLORA_OAUTH_PORT=8080
HERE_API_KEY=
OUTLINE_API_KEY=
OUTLINE_MCP_URL=https://docs.apt346.casa/mcp
# Optional loopback callback for pnpm run todoist:login.
# TODOIST_OAUTH_REDIRECT_URL=http://127.0.0.1:5533/oauth/callback
# Optional Cloudflare Access service token for Outline.
OUTLINE_CF_ACCESS_CLIENT_ID=
OUTLINE_CF_ACCESS_CLIENT_SECRET=
FLORA_TIMEZONE=America/Los_Angeles
# Persist this directory alongside the SQLite database when deploying.
# FLORA_ATTACHMENTS_DIR=/absolute/path/to/attachments
# Optional absolute SQLite URL to share one database with Mastra Studio.
# FLORA_DATABASE_URL=file:/absolute/path/to/flora/mastra.db
# Optional absolute path. Defaults to ~/.config/flora/oauth.json.
# CODEX_AUTH_FILE=/absolute/path/to/oauth.json
